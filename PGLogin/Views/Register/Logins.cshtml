@model PGLogin.Models.Register
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: 'Poppins', sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #4e54c8, #8f94fb);
        overflow: hidden;
    }

    /* Floating Animation Blobs */
    .blob {
        position: absolute;
        width: 350px;
        height: 350px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(5px);
        border-radius: 50%;
        animation: float 8s infinite ease-in-out;
    }

    .blob:nth-child(1) { top: -80px; left: -80px; }
    .blob:nth-child(2) { bottom: -80px; right: -80px; animation-delay: 3s; }

    @@keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-40px); }
    }

    /* Login Card */
    .login-card {
        background: rgba(255, 255, 255, 0.15);
        padding: 45px 40px;
        width: 100%;
        max-width: 420px;
        border-radius: 20px;
        backdrop-filter: blur(12px);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
        animation: fadeIn 0.9s ease;
        color: #fff;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .login-title {
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 10px;
        color: #fff;
    }

    .login-subtitle {
        text-align: center;
        margin-bottom: 30px;
        color: #e0e0e0;
    }

    .form-label {
        color: #fff;
        font-weight: 600;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 12px;
        color: #fff;
    }

    .form-control::placeholder {
        color: #e8e8e8;
    }

    .form-control:focus {
        background: rgba(255, 255, 255, 0.25);
        border-color: #fff;
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
        color: #fff;
    }

    .btn-primary {
        background: linear-gradient(90deg, #6a11cb, #2575fc);
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-weight: 600;
        width: 100%;
        font-size: 1.1rem;
        transition: 0.3s;
    }

    .btn-primary:hover {
        transform: scale(1.05);
        box-shadow: 0 10px 25px rgba(37, 117, 252, 0.4);
    }

    .forgot-link {
        display: block;
        text-align: center;
        margin-top: 12px;
        color: #fff;
        text-decoration: none;
        font-weight: 500;
    }

    .forgot-link:hover {
        text-decoration: underline;
    }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 20px;
        color: #e6e6e6;
        text-decoration: none;
        font-weight: 500;
    }

    .back-link:hover {
        text-decoration: underline;
    }

    .text-danger { color: #ffbaba !important; }
</style>

<div class="blob"></div>
<div class="blob"></div>

<div class="login-card">
    <h1 class="login-title">Welcome Back 👋</h1>
    <p class="login-subtitle">Login to your account to continue</p>

    <form asp-action="Logins">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" placeholder="Enter your email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group mb-4">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" class="form-control" type="password" placeholder="Enter your password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" asp-controller="Register" asp-action="LoginUser" class="btn btn-primary">Login</button>

        <a asp-controller="Register" asp-action="ForgotPass" class="forgot-link">Forgot Password?</a>
    </form>

    <a asp-action="Index" asp-controller="Home" class="back-link">← Back to Home</a>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
