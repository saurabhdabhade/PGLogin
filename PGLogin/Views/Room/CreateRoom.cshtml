@model PGLogin.Models.Room

@{
	ViewData["Title"] = "Create Room";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>

	/* ---------- GLOBAL ---------- */
	body {
		font-family: 'Inter', sans-serif;
		background: linear-gradient(145deg, #f3f4f7, #ffffff);
		min-height: 100vh;
		padding-bottom: 40px;
	}

	/* ---------- CARD ENTRY ANIMATION ---------- */
	@@keyframes slideFadeUp {
		0% {
			opacity: 0;
			transform: translateY(35px);
		}

		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.apple-card {
		border-radius: 26px;
		padding: 0;
		overflow: hidden;
		animation: slideFadeUp 0.7s ease-out forwards;
		background: rgba(255, 255, 255, 0.65);
		backdrop-filter: saturate(180%) blur(28px);
		box-shadow: 0px 25px 70px rgba(0,0,0,0.12);
		transition: 0.5s cubic-bezier(.25,.8,.25,1);
		border: 1px solid rgba(255, 255, 255, 0.55);
	}

		.apple-card:hover {
			transform: translateY(-8px);
			box-shadow: 0px 30px 80px rgba(0,0,0,0.16);
		}

	/* ---------- HEADER ---------- */
	.apple-header {
		background: linear-gradient(120deg, #4c6ef5, #1ea7ff);
		text-align: center;
		padding: 34px 20px;
		color: white;
		letter-spacing: .5px;
		box-shadow: inset 0 -8px 15px rgba(255,255,255,0.15);
	}

		.apple-header h2 {
			font-size: 28px;
			font-weight: 700;
			margin: 0;
		}

	/* ---------- INPUTS ---------- */
	.apple-input, .apple-select, textarea {
		border-radius: 14px;
		padding: 14px 16px;
		border: 1px solid #d5d9e5;
		font-size: 1rem;
		background: #fdfdfd;
		transition: 0.25s ease;
		box-shadow: 0px 2px 8px rgba(0,0,0,0.04);
	}

		/* Shadow morph on focus */
		.apple-input:focus, .apple-select:focus, textarea:focus {
			border-color: #4c6ef5;
			outline: none;
			box-shadow: 0px 4px 16px rgba(76,110,245,0.25);
			transform: translateY(-2px);
		}

	label {
		font-weight: 600;
		margin-bottom: 6px;
		color: #3a3a3a;
	}

	/* ---------- FILE INPUT ---------- */
	input[type=file]::-webkit-file-upload-button {
		background: linear-gradient(90deg, #4c6ef5, #1ea7ff);
		border: none;
		padding: 8px 16px;
		color: #fff;
		border-radius: 10px;
		cursor: pointer;
		transition: 0.25s ease;
		font-weight: 600;
	}

		input[type=file]::-webkit-file-upload-button:hover {
			transform: translateY(-2px);
		}

	/* ---------- BUTTONS ---------- */

	/* Apple bounce effect */
	@@keyframes softBounce {
		0% {
			transform: scale(.98);
		}

		50% {
			transform: scale(1.015);
		}

		100% {
			transform: scale(1);
		}
	}

	.btn-apple {
		background: linear-gradient(120deg, #4c6ef5, #1ea7ff);
		color: white;
		border: none;
		border-radius: 14px;
		font-weight: 700;
		padding: 12px 28px;
		font-size: 1.1rem;
		letter-spacing: .4px;
		transition: 0.25s ease;
		animation: softBounce 0.7s ease-out;
		box-shadow: 0px 10px 25px rgba(76,110,245,0.35);
	}

		.btn-apple:hover {
			transform: translateY(-4px) scale(1.02);
			box-shadow: 0px 14px 30px rgba(76,110,245,0.45);
		}

	.btn-outline-apple {
		border-radius: 14px;
		font-weight: 700;
		padding: 12px 26px;
		border: 2px solid #4c6ef5;
		color: #4c6ef5;
		transition: 0.25s ease;
	}

		.btn-outline-apple:hover {
			background: #4c6ef5;
			color: #fff;
			transform: translateY(-4px);
			box-shadow: 0px 10px 24px rgba(76,110,245,0.35);
		}

</style>


<div class="container mt-5">
	<div class="row justify-content-center">

		<div class="col-md-8 col-lg-6">

			<div class="apple-card">

				<div class="apple-header">
					<h2><i class="bi bi-house-add"></i> Add New PG</h2>
				</div>

				<div class="p-4 p-md-5">

					<form asp-action="Create" enctype="multipart/form-data">

						<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

						<!-- Room Number -->
						<div class="mb-3">
							<label asp-for="RoomNumber"></label>
							<input asp-for="RoomNumber" class="form-control apple-input" placeholder="Enter Room Number" />
							<span asp-validation-for="RoomNumber" class="text-danger small"></span>
						</div>

						<!-- Rent Per Month -->
						<div class="mb-3">
							<label asp-for="RentPerMonth"></label>
							<input asp-for="RentPerMonth" class="form-control apple-input" placeholder="Enter Rent" />
							<span asp-validation-for="RentPerMonth" class="text-danger small"></span>
						</div>

						<!-- Status Dropdown -->
						<div class="mb-3">
							<label asp-for="Status"></label>
							<select asp-for="Status" class="form-select apple-select"
									asp-items="Html.GetEnumSelectList<PGLogin.Models.RoomStatus>()">
								<option value="">Select Room Status</option>
							</select>
							<span asp-validation-for="Status" class="text-danger small"></span>
						</div>

						<!-- Notes -->
						<div class="mb-3">
							<label asp-for="Notes"></label>
							<textarea asp-for="Notes" class="form-control apple-input" rows="3" placeholder="Write notes..."></textarea>
							<span asp-validation-for="Notes" class="text-danger small"></span>
						</div>

						<div class="mb-3">
							<label asp-for="Address"></label>
							<input asp-for="Address" class="form-control apple-input" placeholder="Enter Your Address" />
							<span asp-validation-for="Address" class="text-danger small"></span>
						</div>

						<div class="mb-3">
							<label asp-for="Description"></label>
							<textarea asp-for="Description" class="form-control apple-input" rows="3" placeholder="Description..."></textarea>
							<span asp-validation-for="Description" class="text-danger small"></span>
						</div>

						<!-- Image Upload -->
						<div class="mb-4">
							<label asp-for="ImageFile"></label>
							<input asp-for="ImageFile" type="file" accept="image/*" class="form-control apple-input" />
							<span asp-validation-for="ImageFile" class="text-danger small"></span>
						</div>

						<!-- Buttons -->
						<div class="d-flex justify-content-between">
							<a asp-action="Index" class="btn-outline-apple">
								<i class="bi bi-arrow-left"></i> Back
							</a>

							<button type="submit" class="btn-apple">
								<i class="bi bi-check2-circle"></i> Save Room
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
