@model PGLogin.Models.Booking

@{
    ViewData["Title"] = "Edit Room";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    body {
        background: #f5f7fa;
    }

    .edit-card {
        background: #ffffff;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        transition: 0.3s ease;
    }

        .edit-card:hover {
            transform: scale(1.01);
        }

    .form-label {
        font-weight: 600;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #3f51b5;
    }
</style>

<div class="container mt-4">

    <h2 class="page-title mb-3"><i class="bi bi-pencil-square"></i> Edit Booking / Room</h2>

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="edit-card">

                <form asp-action="EditRoom">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="BookingId" />

                    <div class="mb-3">
                        <label asp-for="CandidateId" class="form-label"></label>
                        <input asp-for="CandidateId" class="form-control shadow-sm" placeholder="Enter Candidate ID" />
                        <span asp-validation-for="CandidateId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RoomId" class="form-label"></label>
                        <input asp-for="RoomId" class="form-control shadow-sm" placeholder="Enter Room ID" />
                        <span asp-validation-for="RoomId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StartDate" class="form-label"></label>
                        <input asp-for="StartDate" class="form-control shadow-sm" type="date" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EndDate" class="form-label"></label>
                        <input asp-for="EndDate" class="form-control shadow-sm" type="date" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Active" />
                        <label class="form-check-label fw-bold">
                            @Html.DisplayNameFor(model => model.Active)
                        </label>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SecurityDeposit" class="form-label"></label>
                        <input asp-for="SecurityDeposit" class="form-control shadow-sm" placeholder="Enter Security Amount" />
                        <span asp-validation-for="SecurityDeposit" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Seats" class="form-label"></label>
                        <input asp-for="Seats" class="form-control shadow-sm" placeholder="Enter The Seats" />
                        <span asp-validation-for="Seats" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 shadow-sm">
                        <i class="bi bi-check-circle"></i> Save Changes
                    </button>

                </form>

            </div>

            <div class="text-center mt-3">
                <a asp-action="GetsBookings" class="fw-bold text-decoration-none">
                    <i class="bi bi-arrow-left-circle"></i> Back to List
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
