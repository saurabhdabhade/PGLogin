@model PGLogin.Models.PG

@{
    ViewData["Title"] = "Create_PG";
}

<h1>Create_PG</h1>

<h4>PG</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create_PG">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="PG_Name" class="control-label"></label>
                <input asp-for="PG_Name" class="form-control" />
                <span asp-validation-for="PG_Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
