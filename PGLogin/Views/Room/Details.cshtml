@model PGLogin.Models.Room

@{
    ViewData["Title"] = "Room Details";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(135deg, #e3f2ff, #ffffff, #e8eaff);
        font-family: 'Poppins', sans-serif;
        padding-top: 20px;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(12px);
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        padding: 35px;
        animation: fadeIn 0.7s ease-in-out;
    }

    @@keyframes fadeIn {
        0% { opacity: 0; transform: translateY(15px); }
        100% { opacity: 1; transform: translateY(0); }
    }

    .detail-title {
        font-size: 32px;
        font-weight: 700;
        color: #3b3b98;
        text-align: center;
        margin-bottom: 20px;
    }

    dl dt {
        font-weight: 600;
        color: #555;
    }

    dl dd {
        font-size: 17px;
        color: #333;
        margin-bottom: 12px;
    }

    .btn-custom {
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 600;
        box-shadow: 0 5px 12px rgba(0, 0, 0, 0.1);
        transition: 0.3s;
    }

    .btn-edit {
        background: #4b7bec;
        color: #fff;
    }

    .btn-edit:hover {
        background: #3867d6;
        transform: translateY(-2px);
    }

    .btn-back {
        background: #d1d8e0;
        color: #2d3436;
    }

    .btn-back:hover {
        background: #b2bec3;
        transform: translateY(-2px);
    }

    .image-card {
        width: 100%;
        max-width: 330px;
        border-radius: 18px;
        overflow: hidden;
        margin-bottom: 20px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .image-card img {
        width: 100%;
        height: auto;
        object-fit: cover;
    }
</style>


<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="glass-card">
                <h1 class="detail-title">
                    <i class="bi bi-door-closed"></i> Room Details
                </h1>

                <div class="row">
                    <div class="col-md-4 text-center">
                        <div class="image-card">
                            <img src="@Model.ImagePath" alt="Room Image" />
                        </div>
                    </div>

                    <div class="col-md-8">
                        <dl class="row">

                            <dt class="col-sm-4"><i class="bi bi-hash"></i> Room Number</dt>
                            <dd class="col-sm-8">@Model.RoomNumber</dd>

                            <dt class="col-sm-4"><i class="bi bi-cash-coin"></i> Rent Per Month</dt>
                            <dd class="col-sm-8">₹ @Model.RentPerMonth</dd>

                            <dt class="col-sm-4"><i class="bi bi-activity"></i> Status</dt>
                            <dd class="col-sm-8">@Model.Status</dd>

                            <dt class="col-sm-4"><i class="bi bi-card-text"></i> Notes</dt>
                            <dd class="col-sm-8">@Model.Notes</dd>

                            <dt class="col-sm-4"><i class="bi bi-geo-alt"></i> Address</dt>
                            <dd class="col-sm-8">@Model.Address</dd>

                            <dt class="col-sm-4"><i class="bi bi-info-circle"></i> Description</dt>
                            <dd class="col-sm-8">@Model.Description</dd>

                            <dt class="col-sm-4"><i class="bi bi-image"></i> Image Path</dt>
                            <dd class="col-sm-8">@Model.ImagePath</dd>

                        </dl>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-between">
                    <a asp-action="EditRoom" asp-route-id="@Model?.RoomId" 
                       class="btn btn-custom btn-edit">
                        <i class="bi bi-pencil-square"></i> Edit Room
                    </a>

                    <a asp-action="Index" 
                       class="btn btn-custom btn-back">
                        <i class="bi bi-arrow-left-circle"></i> Back to List
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>
