@model IEnumerable<PGLogin.Models.Candidate>

@{
	ViewData["Title"] = "Candidates List";
}

<div class="container mt-5">
	<div class="card shadow-lg border-0 rounded-4">
		<div class="card-header bg-primary text-white text-center rounded-top-4">
			<h2 class="mb-0"><i class="bi bi-people-fill"></i> Candidates List</h2>
		</div>

		<div class="card-body">
			<div class="d-flex justify-content-between align-items-center mb-4">
				<p class="mb-0 text-muted">Manage all registered candidates below.</p>
				<a asp-action="CreateCandidate" class="btn btn-success rounded-pill px-4">
					<i class="bi bi-plus-circle"></i> Create New
				</a>
			</div>

			@if (Model != null && Model.Any())
			{
				<div class="row g-4">
					@foreach (var item in Model)
					{
						<div class="col-md-4 col-lg-3">
							<div class="card h-100 shadow-sm border-0 rounded-4">
								<div class="card-body text-center p-4">
									@if (!string.IsNullOrEmpty(item.My_Photo))
									{
										<img src="@Url.Content(item.My_Photo)" alt="@item.FullName"
											 class="rounded-circle mb-3 shadow-sm"
											 width="100" height="100" style="object-fit: cover;" />
									}
									else
									{
										<div class="rounded-circle bg-light d-flex align-items-center justify-content-center mb-3 shadow-sm"
											 style="width:100px; height:100px;">
											<i class="bi bi-person-circle text-secondary" style="font-size: 3rem;"></i>
										</div>
									}

									<h5 class="fw-bold mb-1">@item.FullName</h5>
									<p class="text-muted small mb-1">
										<i class="bi bi-telephone-fill"></i> @item.Phone
									</p>
									<p class="text-muted small mb-1">
										<i class="bi bi-envelope-fill"></i> @item.Email
									</p>
									<p class="text-muted small">
										<i class="bi bi-geo-alt-fill"></i> @item.Address
									</p>

									<p class="text-muted small mb-3">
										<i class="bi bi-calendar3"></i>
										Joined: @item.CreatedAt.ToString("dd-MMM-yyyy")
									</p>

									<div class="d-flex justify-content-center gap-2 mt-auto">
										<a asp-action="EditCandidate" asp-route-id="@item.CandidateId"
										   class="btn btn-warning btn-sm rounded-pill px-3">
											<i class="bi bi-pencil-square"></i> Edit
										</a>
										<a asp-action="Details" asp-route-id="@item.CandidateId"
										   class="btn btn-info btn-sm rounded-pill px-3 text-white">
											<i class="bi bi-eye"></i> View
										</a>
										<a asp-action="DeleteCandidate" asp-route-id="@item.CandidateId"
										   class="btn btn-danger btn-sm rounded-pill px-3">
											<i class="bi bi-trash"></i> Delete
										</a>
									</div>
								</div>
							</div>
						</div>
					}
				</div>
			}
			else
			{
				<div class="text-center text-muted py-5 bg-light rounded-4">
					<i class="bi bi-emoji-frown display-5 d-block mb-2"></i>
					<h5>No candidates available.</h5>
				</div>
			}
		</div>
	</div>
	<nav>
		<ul class="pagination justify-content-center mt-4">

			<li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
				<a class="page-link"
				   href="@Url.Action("GetsCandidates", new { page = ViewBag.CurrentPage - 1, pageSize = ViewBag.PageSize })">
					Previous
				</a>
			</li>

			@for (int i = 1; i <= ViewBag.TotalPages; i++)
			{
				<li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
					<a class="page-link"
					   href="@Url.Action("GetsCandidates", new { page = i, pageSize = ViewBag.PageSize })">
						@i
					</a>
				</li>
			}

			<li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
				<a class="page-link"
				   href="@Url.Action("GetsCandidates", new { page = ViewBag.CurrentPage + 1, pageSize = ViewBag.PageSize })">
					Next
				</a>
			</li>

		</ul>
	</nav>
</div>

@section Styles {
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
	<style>
		body {
			background: linear-gradient(to right, #f8f9fa, #e3f2fd);
		}

		.card {
			transition: transform 0.3s ease, box-shadow 0.3s ease;
		}

			.card:hover {
				transform: scale(1.03);
				box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
			}

			.card img {
				border: 3px solid #007bff;
			}

		h5 {
			color: #0d6efd;
		}

		.btn {
			font-size: 0.85rem;
		}
	</style>
}
