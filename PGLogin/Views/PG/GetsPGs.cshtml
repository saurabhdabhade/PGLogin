@model IEnumerable<PGLogin.Models.PG>

@{
    ViewData["Title"] = "Available PGs";
}
<Style>
    /* Premium Hover Effect */
    .premium-row {
        transition: all 0.25s ease-in-out;
    }

        .premium-row:hover {
            background-color: #f8f9fa;
            transform: scale(1.01);
        }

    /* Button polish */
    .btn-group .btn {
        margin-right: 3px;
    }

    /* Image hover zoom */
    img:hover {
        transform: scale(1.05);
        transition: transform 0.3s ease;
    }

</Style>
<div class="container-fluid px-4 py-3">

    <!-- Page Header -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h3 class="fw-bold text-primary mb-0">
                <i class="bi bi-buildings"></i> Available PGs
            </h3>

            <a asp-action="Create" class="btn btn-success px-4 shadow-sm">
                <i class="bi bi-plus-circle"></i> Create New
            </a>
        </div>
    </div>

    <!-- PG List Card -->
    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-dark">
                        <tr>
                            <th>PG Name</th>
                            <th>Price</th>
                            <th>Sharing</th>
                            <th>Preview</th>
                            <th>Area</th>
                            <th style="width:180px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="premium-row">
                                <!-- PG Name -->
                                <td class="fw-semibold text-dark">
                                    @item.PG_Name
                                </td>

                                <!-- Price -->
                                <td>
                                    @* <span class="badge bg-success fs-6 px-3 py-2">
                                        ₹ @item.Price.ToString("N0")
                                    </span> *@
                                </td>

                                <!-- Sharing -->
                                <td>
                                    <span class="badge bg-info text-dark px-3 py-2">
                                        @item.SharingType
                                    </span>
                                </td>

                                <!-- Image Preview -->
                                <td>
                                    <img src="@item.ImagePath"
                                         class="rounded-3 shadow-sm"
                                         style="width:90px;height:65px;object-fit:cover;"
                                         alt="PG Image" />
                                </td>

                                <!-- Area -->
                                <td class="fw-medium text-muted">
                                    <i class="bi bi-geo-alt-fill text-danger"></i>
                                    @item.Area.AreaName
                                </td>

                                <!-- Actions -->
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.PG_Id"
                                           class="btn btn-sm btn-warning"
                                           title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a asp-action="Details" asp-route-id="@item.PG_Id"
                                           class="btn btn-sm btn-primary"
                                           title="View Details">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>

                                        <a asp-action="Delete" asp-route-id="@item.PG_Id"
                                           class="btn btn-sm btn-danger"
                                           title="Delete"
                                           onclick="return confirm('Are you sure you want to delete this PG?');">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
