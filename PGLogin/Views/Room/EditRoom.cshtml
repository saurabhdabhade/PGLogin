@model PGLogin.Models.Room

@{
    ViewData["Title"] = "Edit Room";
}
<style>
    .card {
        transition: transform 0.2s ease-in-out;
    }
    .card:hover {
        transform: scale(1.02);
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-gradient text-white rounded-top-4" 
                     style="background: linear-gradient(90deg, #007bff, #6610f2);">
                    <h3 class="mb-0 text-center">✏️ Edit Room Details</h3>
                </div>

                <div class="card-body p-4">
                    <form asp-action="EditRoom" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="RoomId" />

                        <div class="mb-3">
                            <label asp-for="RoomNumber" class="form-label fw-bold"></label>
                            <input asp-for="RoomNumber" class="form-control rounded-3" placeholder="Enter room number" />
                            <span asp-validation-for="RoomNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RentPerMonth" class="form-label fw-bold"></label>
                            <input asp-for="RentPerMonth" class="form-control rounded-3" placeholder="Enter rent per month" />
                            <span asp-validation-for="RentPerMonth" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-bold"></label>
                            <select asp-for="Status" class="form-select rounded-3">
                                <option value="">-- Select Status --</option>
                                <option value="Available">Available</option>
                                <option value="Occupied">Occupied</option>
                                <option value="Maintenance">Maintenance</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-bold"></label>
                            <textarea asp-for="Notes" class="form-control rounded-3" rows="3" placeholder="Enter any notes here..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="ImageFile" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="ImageFile" class="form-control form-control-lg shadow-sm"
                                   type="file" accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="GetsRooms" class="btn btn-outline-secondary px-4 rounded-3">
                                ← Back to List
                            </a>
                            <button type="submit" class="btn btn-primary px-4 rounded-3 shadow-sm">
                                💾 Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <small class="text-muted">PG Management System © 2025</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
