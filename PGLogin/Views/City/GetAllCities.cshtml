@model IEnumerable<PGLogin.Models.City>

@{
	ViewData["Title"] = "All Cities";
}

<div class="container py-5">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h2 class="fw-bold text-primary mb-0">
			<i class="bi bi-building me-2"></i> All Cities
		</h2>
		<a asp-action="CreateCity" class="btn btn-primary rounded-pill shadow-sm">
			<i class="bi bi-plus-circle me-1"></i> Create New
		</a>
	</div>

	@if (Model != null && Model.Any())
	{
		<div class="row g-4">
			@foreach (var item in Model)
			{
				<div class="col-md-4 col-lg-3 col-sm-6">
					<div class="card shadow-sm border-0 rounded-4 h-100 city-card">
						<div class="card-body">
							<h5 class="card-title text-primary fw-bold mb-2">
								<i class="bi bi-geo-alt-fill me-1"></i> @item.City_Name
							</h5>
							<div class="mb-4">
								<i class="bi bi-list-ul me-1 text-muted"></i>

								@if (item.Areas != null && item.Areas.Any())
								{
									foreach (var area in item.Areas)
									{
										<span class="badge bg-light text-dark border me-1 mb-1">
											@string.Join(", ", item.AreaName ?? new List<string>())
										</span>
									}
								}
								else
								{
									<span class="text-muted">No Areas</span>
								}
							</div>


							<div class="d-flex justify-content-between">
								<a asp-action="EditCity" asp-route-id="@item.City_Id" class="btn btn-outline-warning btn-sm rounded-pill px-3">
									<i class="bi bi-pencil-square"></i> Edit
								</a>
								<a asp-action="Details" asp-route-id="@item.City_Id" class="btn btn-outline-info btn-sm rounded-pill px-3">
									<i class="bi bi-info-circle"></i> Details
								</a>
								<a asp-action="Delete" asp-route-id="@item.City_Id" class="btn btn-outline-danger btn-sm rounded-pill px-3">
									<i class="bi bi-trash"></i> Delete
								</a>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
	else
	{
		<div class="alert alert-info text-center rounded-3 mt-5 shadow-sm">
			<i class="bi bi-exclamation-circle"></i> No cities found.
		</div>
	}
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}

<style>
	.city-card {
		transition: all 0.3s ease;
	}

		.city-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
		}
</style>
