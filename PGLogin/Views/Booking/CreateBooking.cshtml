@model PGLogin.Models.Booking

@{
    ViewData["Title"] = "Create Booking";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(135deg, #dbeafe, #f8fafc);
        font-family: 'Poppins', sans-serif;
    }

    .card-glass {
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        padding: 30px 35px;
        box-shadow: 0px 8px 25px rgba(0,0,0,0.12);
        transition: 0.35s ease;
        animation: fadeIn 0.7s ease;
    }

        .card-glass:hover {
            transform: translateY(-7px);
            box-shadow: 0px 16px 30px rgba(0,0,0,0.15);
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .title-bar {
        background: linear-gradient(90deg, #4c6ef5, #15aabf);
        padding: 18px;
        text-align: center;
        border-radius: 20px;
        margin-bottom: 25px;
        color: #fff;
        font-weight: 700;
        font-size: 26px;
        box-shadow: 0px 4px 15px rgba(76, 110, 245, 0.35);
        letter-spacing: 0.5px;
    }

    .form-label {
        font-weight: 600;
        color: #334155;
    }

    .form-control, .form-check-input {
        border-radius: 14px;
        padding: 12px 16px;
        border: 1px solid #d0d7de;
        transition: 0.25s ease;
    }

        .form-control:focus, .form-check-input:focus {
            border-color: #4c6ef5;
            box-shadow: 0 0 10px rgba(76, 110, 245, 0.35);
        }

    .btn-premium {
        background: linear-gradient(90deg, #4c6ef5, #15aabf);
        border: none;
        padding: 12px;
        border-radius: 16px;
        font-size: 1.1rem;
        font-weight: 600;
        color: #fff;
        transition: 0.3s ease;
        box-shadow: 0px 8px 20px rgba(76, 110, 245, 0.35);
    }

        .btn-premium:hover {
            transform: scale(1.04);
            box-shadow: 0px 12px 28px rgba(76, 110, 245, 0.5);
        }

    .back-link {
        font-weight: 600;
        color: #475569;
        transition: 0.3s;
        font-size: 1rem;
    }

        .back-link:hover {
            color: #334155;
            text-decoration: underline;
        }
</style>

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">

            <div class="title-bar">
                <i class="bi bi-journal-plus"></i> Create Booking
            </div>

            <div class="card-glass">

                <form asp-action="CreateBooking">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Candidate ID -->
                    <div class="mb-3">
                        <label asp-for="CandidateId" class="form-label"></label>
                        <input asp-for="CandidateId" class="form-control shadow-sm" placeholder="Enter Candidate ID" />
                        <span asp-validation-for="CandidateId" class="text-danger"></span>
                    </div>

                    <!-- Room ID -->
                    <div class="mb-3">
                        <label asp-for="RoomId" class="form-label"></label>
                        <input asp-for="RoomId" value="@ViewBag.RoomId" class="form-control shadow-sm" placeholder="Enter Room ID" />
                        <span asp-validation-for="RoomId" class="text-danger"></span>
                    </div>

                    <!-- Start Date -->
                    <div class="mb-3">
                        <label asp-for="StartDate" class="form-label"></label>
                        <input asp-for="StartDate" class="form-control shadow-sm" type="date" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>

                    <!-- End Date -->
                    <div class="mb-3">
                        <label asp-for="EndDate" class="form-label"></label>
                        <input asp-for="EndDate" class="form-control shadow-sm" type="date" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>

                    <!-- Active -->
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Active" />
                        <label class="form-check-label fw-bold">
                            @Html.DisplayNameFor(model => model.Active)
                        </label>
                    </div>

                    <!-- Security Deposit -->
                    <div class="mb-4">
                        <label asp-for="SecurityDeposit" class="form-label"></label>
                        <input asp-for="SecurityDeposit" class="form-control shadow-sm"
                               placeholder="Enter Security Amount" />
                        <span asp-validation-for="SecurityDeposit" class="text-danger"></span>
                    </div>
                    <div class="mb-4" readonly disabled>
                        <label asp-for="Seats" class="form-label"></label>
                        <input asp-for="Seats" class="form-control shadow-sm"
                               placeholder="Enter The Seats" />
                        <span asp-validation-for="Seats" class="text-danger"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" asp-action="Create" class="btn-premium w-100">
                        <i class="bi bi-check2-circle"></i> Confirm Booking
                    </button>
                </form>

            </div>

            <div class="text-center mt-4">
                <a asp-action="GetsBookings" class="back-link">
                    <i class="bi bi-arrow-left-circle"></i> Back to List
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @@await Html.RenderPartialAsync("_ValidationScriptsPartial")
}
