@model PGLogin.Models.Candidate

@{
    ViewData["Title"] = "Edit Candidate";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white text-center rounded-top-4">
            <h2 class="mb-0"><i class="bi bi-person-lines-fill"></i> Edit Candidate</h2>
        </div>

        <div class="card-body px-5 py-4">
            <form asp-action="EditCandidate" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="CandidateId" />

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-bold"></label>
                        <input asp-for="FullName" class="form-control rounded-pill shadow-sm" placeholder="Enter full name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-bold"></label>
                        <input asp-for="Phone" class="form-control rounded-pill shadow-sm" placeholder="Enter phone number" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control rounded-pill shadow-sm" placeholder="Enter email address" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label fw-bold"></label>
                        <input asp-for="Address" class="form-control rounded-pill shadow-sm" placeholder="Enter address" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="My_Photo" class="form-label fw-bold"></label>
                        <input asp-for="My_Photo" type="file" class="form-control rounded-pill shadow-sm" />
                        <span asp-validation-for="My_Photo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CreatedAt" class="form-label fw-bold"></label>
                        <input asp-for="CreatedAt" class="form-control rounded-pill shadow-sm" readonly />
                        <span asp-validation-for="CreatedAt" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-center mt-5 gap-3">
                    <button type="submit" asp-action="EditCandidate"class="btn btn-success px-4 py-2 rounded-pill shadow-sm">
                        <i class="bi bi-check-circle"></i> Save Changes
                    </button>
                    <a asp-action="GetsCandidates" class="btn btn-secondary px-4 py-2 rounded-pill shadow-sm">
                        <i class="bi bi-arrow-left-circle"></i> Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(to right, #f8f9fa, #e3f2fd);
            font-family: 'Segoe UI', sans-serif;
        }

        .card {
            transition: all 0.3s ease;
        }

        .card:hover {
            transform: scale(1.01);
        }

        label {
            color: #0d6efd;
        }

        input.form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 6px rgba(13, 110, 253, 0.5);
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
