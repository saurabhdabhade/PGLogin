@model PGLogin.Models.City

@{
    ViewData["Title"] = "Edit City";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-gradient bg-primary text-white text-center rounded-top-4">
                    <h3 class="mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i> Edit City Details
                    </h3>
                </div>

                <div class="card-body p-4">
                    <form asp-action="EditCity">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="City_Id" />

                        <!-- City Name -->
                        <div class="mb-3">
                            <label asp-for="City_Name" class="form-label fw-semibold">City Name</label>
                            <input asp-for="City_Name" class="form-control shadow-sm" placeholder="Enter city name" />
                            <span asp-validation-for="City_Name" class="text-danger"></span>
                        </div>

                        <!-- Areas -->
                        <div class="mb-3">
                            <label asp-for="Areas" class="form-label fw-semibold">Areas</label>
                            <input asp-for="Areas" class="form-control shadow-sm" placeholder="Enter areas (comma-separated)" />
                            <span asp-validation-for="Areas" class="text-danger"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left-circle"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm">
                                <i class="bi bi-save2"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
